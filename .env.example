# The in-memory backend requires no infrastructure.
ASTRA_PERSISTENCE_BACKEND=memory
ASTRA_AUTH_BACKEND=development_headers
ASTRA_AGENT_URL=http://127.0.0.1:8000
# ASTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ASTRA_USER_ID=00000000-0000-0000-0000-000000000000
# ASTRA_ACCESS_TOKEN=YOUR_OIDC_ACCESS_TOKEN
# For the secure local stack only, obtain the documented development token automatically.
# ASTRA_TUI_DEV_LOGIN=true

# For MariaDB, set the password locally and switch the backend.
# ASTRA_PERSISTENCE_BACKEND=mariadb
# ASTRA_DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/astra_agent?charset=utf8mb4
# ASTRA_TEST_DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/astra_agent?charset=utf8mb4

# Production ARA routes require a trusted mTLS ingress and shared proxy secret.
# ASTRA_AUTH_BACKEND=mtls
# ASTRA_TRUSTED_PROXY_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Production user authentication.
# ASTRA_USER_AUTH_BACKEND=oidc
# ASTRA_OIDC_ISSUER=https://identity.example.com
# ASTRA_OIDC_AUDIENCE=astra-agent
# ASTRA_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ASTRA_OIDC_TENANT_CLAIM=tenant_id

# Conversation model. Development is deterministic and requires no API key.
ASTRA_MODEL_BACKEND=development
# ASTRA_MODEL_BACKEND=openrouter
# ASTRA_OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# ASTRA_OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# ASTRA_PERSONA_MAX_TOKENS=800
# ASTRA_CONVERSATION_HISTORY_MESSAGES=12

# Memory retrieval defaults to MariaDB-authorized lexical ranking.
ASTRA_MEMORY_BACKEND=local
# ASTRA_MEMORY_BACKEND=qdrant
# ASTRA_QDRANT_URL=http://127.0.0.1:6333
# ASTRA_QDRANT_API_KEY=YOUR_QDRANT_KEY
# ASTRA_QDRANT_COLLECTION=astra_memories
# ASTRA_MEMORY_MAX_RECORDS=8
# ASTRA_MEMORY_EXTRACTOR_BACKEND=local_model
# In Docker on macOS, use host.docker.internal to reach an LLM on the host.
# ASTRA_LOCAL_MODEL_URL=http://host.docker.internal:8082/v1
# ASTRA_LOCAL_MODEL_NAME=ggml-org/gemma-4-E2B-it-GGUF:Q8_0
# ASTRA_LOCAL_MODEL_API_KEY=OPTIONAL_LOCAL_KEY

# Bounded automatic delegation for explicit repository inspection requests.
ASTRA_DELEGATION_ENABLED=true
ASTRA_DELEGATION_WAIT_SECONDS=30

# Development MinIO container credentials are configurable through Compose only.
# Production artifact completion verifies object key scope, size, media type, and SHA-256.

# Optional MinIO/S3 artifact uploads.
# ASTRA_ARTIFACT_BUCKET=astra-artifacts
# ASTRA_ARTIFACT_ENDPOINT_URL=http://127.0.0.1:9000
# ASTRA_ARTIFACT_ACCESS_KEY=YOUR_ACCESS_KEY
# ASTRA_ARTIFACT_SECRET_KEY=YOUR_SECRET_KEY
