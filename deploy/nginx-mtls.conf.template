map $ssl_client_s_dn $astra_ara_id {
    default "";
    ~(?:^|,)CN=(?<ara>[^,]+) $ara;
}

map $ssl_client_s_dn $astra_tenant_id {
    default "";
    ~(?:^|,)OU=(?<tenant>[^,]+) $tenant;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_client_certificate /etc/nginx/tls/ca.crt;
    ssl_verify_client on;

    location /api/v1/aras/ {
        proxy_pass http://astra-agent:8000;
        proxy_set_header X-Client-Verify $ssl_client_verify;
        proxy_set_header X-Astra-Cert-Tenant-ID $astra_tenant_id;
        proxy_set_header X-Astra-Cert-ARA-ID $astra_ara_id;
        proxy_set_header X-Astra-Proxy-Secret ${ASTRA_TRUSTED_PROXY_SECRET};
    }
}
